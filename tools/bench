# ---- dispatch ----------------------------------------------------------------------------------

cmd=${1-help}; [ $# -gt 0 ] && shift
case "$cmd" in
  status) cmd_status ;;
  devices|ls) cmd_devices ;;
  scan) cmd_scan "$@" ;;
  info) cmd_info "$@" ;;
  pair|connect|disconnect|trust|untrust|block|unblock|cancel|remove) cmd_device_op "$cmd" "$@" ;;
  discoverable) cmd_discoverable "$@" ;;
  agent) cmd_agent "$@" ;;
  gatt) cmd_gatt "$@" ;;
  adv) cmd_adv "$@" ;;
  audio) cmd_audio "$@" ;;
  media) cmd_media ;;
  cap) cmd_cap "$@" ;;
  mark) cmd_mark "$@" ;;
  mon) cmd_mon "$@" ;;
  wifi) cmd_wifi "$@" ;;
  kernel) cmd_kernel "$@" ;;
  sys) cmd_sys ;;
  logs) cmd_logs "$@" ;;
  bt-args) cmd_bt_args "$@" ;;
  run) cmd_run "$@" ;;
  ssh) cmd_ssh "$@" ;;
  completion) cmd_completion ;;
  version|--version) echo "bench $VERSION" ;;
  help|-h|--help) cmd_help ;;
  *) echo "bench: no such command: $cmd" >&2; cmd_help >&2; exit 2 ;;
esac
