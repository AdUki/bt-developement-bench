Bluetooth: Controller: Periodic and BIG sync establishment, a wider first window and timing events

Two things for the bench's nRF54L15 DK controller, in Zephyr's open link layer:

1. CONFIG_BT_CTLR_SYNC_ESTAB_WINDOW_US (default 0: unchanged). The link layer listens for the first
   AUX_SYNC_IND exactly where the advertiser's SyncInfo offset put it, plus clock drift and the
   offset's own unit. A stream195x board's Infineon controller announces its periodic
   advertising 10 ms (one ISO interval of its BIG) earlier than it sends it: all six establishment
   attempts miss and the sync fails with 0x3e, while tolerant receivers join. The option opens the
   first window that much earlier and longer, bounded by half the periodic interval, and reserves
   the time until the first PDU is in; the anchor is then re-aligned to the PDU, the reservation
   given back, and the normal window applies.

2. CONFIG_BT_CTLR_SYNC_TIMING_EVENTS. After LE Periodic Advertising Sync Established (also a
   failed one) and LE BIG Sync Established, a vendor event (subevent 0xb0, 0xb2; hci_vs.h) says
   where the first PDU landed relative to the announced SyncInfo or BIGInfo offset, how many events
   were listened to and how many PDUs failed their CRC. Measured with it: a stream210 (Realtek) and a
   Galaxy S24 land within 100 us of their SyncInfo, the stream195x 10.0 ms late. A peer whose offsets
   are wrong is then a line in the HCI trace instead of a bare failure, for whoever owns its firmware.

Applied to the workspace's Zephyr tree (ZEPHYR_VERSION) by `make nrf-hci`; the bench's prj.conf
sets both.

diff --git a/include/zephyr/bluetooth/hci_vs.h b/include/zephyr/bluetooth/hci_vs.h
index 529c5045123..57b88075272 100644
--- a/include/zephyr/bluetooth/hci_vs.h
+++ b/include/zephyr/bluetooth/hci_vs.h
@@ -235,6 +235,32 @@ struct bt_hci_evt_vs {
 	uint8_t  subevent;
 } __packed;
 
+/* Diagnostic events of the bench's controller build (CONFIG_BT_CTLR_SYNC_TIMING_EVENTS): after
+ * LE Periodic Advertising Sync Established and LE BIG Sync Established, where the first PDU was
+ * received relative to where the advertiser's SyncInfo or BIGInfo offset announced it (positive:
+ * later), how many events were listened to and how many PDUs failed their CRC on the way.
+ */
+#define BT_HCI_EVT_VS_PER_ADV_SYNC_TIMING      0xb0
+struct bt_hci_evt_vs_per_adv_sync_timing {
+	uint8_t  status;
+	uint16_t sync_handle;
+	uint16_t interval;
+	uint8_t  phy;
+	uint8_t  events;
+	uint8_t  crc_fail;
+	int32_t  first_pdu_offset_us;
+	uint32_t window_us;
+} __packed;
+
+#define BT_HCI_EVT_VS_BIG_SYNC_TIMING          0xb2
+struct bt_hci_evt_vs_big_sync_timing {
+	uint8_t  status;
+	uint8_t  big_handle;
+	uint16_t iso_interval;
+	int32_t  first_pdu_offset_us;
+	uint32_t window_us;
+} __packed;
+
 #define BT_HCI_EVT_VS_ERROR_DATA_TYPE_STACK_FRAME   0x01
 #define BT_HCI_EVT_VS_ERROR_DATA_TYPE_CTRL_ASSERT   0x02
 #define BT_HCI_EVT_VS_ERROR_DATA_TYPE_TRACE         0x03
diff --git a/subsys/bluetooth/controller/Kconfig.ll_sw_split b/subsys/bluetooth/controller/Kconfig.ll_sw_split
index c1ff1ce4228..109694a7660 100644
--- a/subsys/bluetooth/controller/Kconfig.ll_sw_split
+++ b/subsys/bluetooth/controller/Kconfig.ll_sw_split
@@ -575,6 +575,33 @@ config BT_CTLR_SCAN_AUX_SYNC_RESERVE_MIN
 	  reservation would avoid skipping closely scheduled reception of
 	  multiple Auxiliary or Periodic Sync PDUs.
 
+config BT_CTLR_SYNC_ESTAB_WINDOW_US
+	int "Extra receive window while establishing a periodic sync (us)"
+	depends on BT_CTLR_SYNC_PERIODIC
+	default 0
+	range 0 1000000
+	help
+	  Microseconds added before and after the time the SyncInfo offset
+	  names, to the receive window for the first AUX_SYNC_IND of a periodic
+	  advertising sync being established. 0 listens only where the
+	  advertiser announced the PDU, plus clock drift, as the specification
+	  allows. A larger value also synchronizes to advertisers whose SyncInfo
+	  offset is wrong (a controller that sends the PDU one whole ISO interval
+	  later than announced has been seen), at the cost of a longer radio
+	  event and time reservation until the first PDU is received. It is
+	  limited to half the periodic interval.
+
+config BT_CTLR_SYNC_TIMING_EVENTS
+	bool "Vendor events with the timing of periodic and BIG sync establishment"
+	depends on BT_CTLR_SYNC_PERIODIC && BT_HCI_VS
+	help
+	  After LE Periodic Advertising Sync Established and LE BIG Sync
+	  Established, also send a vendor event (subevents 0xb0 and 0xb2)
+	  saying how far the first PDU was from where the advertiser's SyncInfo
+	  or BIGInfo offset announced it, how many events were listened to and
+	  how many PDUs failed their CRC. A peer whose offsets are wrong is then
+	  visible in an HCI trace instead of as a bare failure.
+
 config BT_CTLR_SYNC_PERIODIC_SKIP_ON_SCAN_AUX
 	bool "Skip Periodic Sync event on overlap with Extended Scan Event"
 	depends on BT_CTLR_SYNC_PERIODIC
diff --git a/subsys/bluetooth/controller/hci/hci.c b/subsys/bluetooth/controller/hci/hci.c
index 944b1ec5db0..b8bc915e0cc 100644
--- a/subsys/bluetooth/controller/hci/hci.c
+++ b/subsys/bluetooth/controller/hci/hci.c
@@ -7799,6 +7799,28 @@ static void le_per_adv_sync_established(struct pdu_data *pdu_data,
 	sep->phy = find_lsb_set(se->phy);
 	sep->interval = sys_cpu_to_le16(se->interval);
 	sep->clock_accuracy = se->sca;
+
+#if defined(CONFIG_BT_CTLR_SYNC_TIMING_EVENTS)
+	{
+		struct bt_hci_evt_vs_per_adv_sync_timing *vs;
+		struct net_buf *evt_buf;
+
+		/* The timing of the establishment, as a second event after this one */
+		evt_buf = bt_buf_get_rx(BT_BUF_EVT, BUF_GET_TIMEOUT);
+		LL_ASSERT_ERR(evt_buf);
+		net_buf_frag_add(buf, evt_buf);
+
+		vs = vs_event(evt_buf, BT_HCI_EVT_VS_PER_ADV_SYNC_TIMING, sizeof(*vs));
+		vs->status = se->status;
+		vs->sync_handle = sep->handle;
+		vs->interval = sep->interval;
+		vs->phy = sep->phy;
+		vs->events = se->events;
+		vs->crc_fail = se->crc_fail;
+		vs->first_pdu_offset_us = sys_cpu_to_le32((uint32_t)se->estab_err_us);
+		vs->window_us = sys_cpu_to_le32(sync->lll.estab_extra_us);
+	}
+#endif /* CONFIG_BT_CTLR_SYNC_TIMING_EVENTS */
 }
 
 static void le_per_adv_sync_report(struct pdu_data *pdu_data,
@@ -8208,6 +8230,25 @@ static void le_big_sync_established(struct pdu_data *pdu,
 
 	se = node;
 	sep->status = se->status;
+
+#if defined(CONFIG_BT_CTLR_SYNC_TIMING_EVENTS)
+	if (se->status != BT_HCI_ERR_OP_CANCELLED_BY_HOST) {
+		struct bt_hci_evt_vs_big_sync_timing *vs;
+		struct net_buf *evt_buf;
+
+		/* The timing of the establishment, as a second event after this one */
+		evt_buf = bt_buf_get_rx(BT_BUF_EVT, BUF_GET_TIMEOUT);
+		LL_ASSERT_ERR(evt_buf);
+		net_buf_frag_add(buf, evt_buf);
+
+		vs = vs_event(evt_buf, BT_HCI_EVT_VS_BIG_SYNC_TIMING, sizeof(*vs));
+		vs->status = se->status;
+		vs->big_handle = sep->big_handle;
+		vs->iso_interval = sys_cpu_to_le16(lll->iso_interval);
+		vs->first_pdu_offset_us = sys_cpu_to_le32((uint32_t)se->estab_err_us);
+		vs->window_us = sys_cpu_to_le32(se->window_us);
+	}
+#endif /* CONFIG_BT_CTLR_SYNC_TIMING_EVENTS */
 	if (sep->status) {
 		return;
 	}
