diff --git a/subsys/bluetooth/controller/ll_sw/nordic/lll/lll_sync.c b/subsys/bluetooth/controller/ll_sw/nordic/lll/lll_sync.c
index 1da34a1a492..f66e63b48a8 100644
--- a/subsys/bluetooth/controller/ll_sw/nordic/lll/lll_sync.c
+++ b/subsys/bluetooth/controller/ll_sw/nordic/lll/lll_sync.c
@@ -797,6 +797,21 @@ static int isr_rx(struct lll_sync *lll, uint8_t node_type, uint8_t crc_ok,
 	bool sched = false;
 	int err;
 
+	/* Where did the establishing PDU land relative to where the SyncInfo
+	 * offset put it (positive: later)? The nominal position in the window
+	 * is the jitter and ticker margins, the widening and the extra
+	 * establishment window opened before it, then the preamble and
+	 * access address.
+	 */
+	if (crc_ok && (node_type == NODE_RX_TYPE_SYNC)) {
+		uint32_t actual_us = radio_tmr_aa_restore() - radio_tmr_ready_restore();
+		uint32_t nominal_us = EVENT_JITTER_US + EVENT_TICKER_RES_MARGIN_US +
+				      lll->window_widening_event_us + lll->estab_extra_us +
+				      addr_us_get(lll->phy);
+
+		lll->estab_err_us = (int32_t)actual_us - (int32_t)nominal_us;
+	}
+
 	/* Check CRC and generate Periodic Advertising Report */
 	if (crc_ok) {
 		struct node_rx_pdu *node_rx;
diff --git a/subsys/bluetooth/controller/ll_sw/ull_sync.c b/subsys/bluetooth/controller/ll_sw/ull_sync.c
index 001740e1219..74e572558ea 100644
--- a/subsys/bluetooth/controller/ll_sw/ull_sync.c
+++ b/subsys/bluetooth/controller/ll_sw/ull_sync.c
@@ -279,6 +279,10 @@ void ull_sync_setup_from_sync_transfer(struct ll_conn *conn, uint16_t service_da
 	}
 
 	sync->sync_expire = CONN_ESTAB_COUNTDOWN;
+	sync->estab_events = 0U;
+	sync->estab_crc_fail = 0U;
+	lll->estab_extra_us = 0U;
+	lll->estab_err_us = 0;
 
 	/* Extract the SCA value from the sca_chm field of the sync_info
 	 * structure.
@@ -956,6 +960,7 @@ void ull_sync_setup(struct ll_scan_set *scan, uint8_t phy,
 	uint16_t sync_handle;
 	uint32_t interval_us;
 	uint32_t overhead_us;
+	uint32_t estab_extra_us;
 	struct pdu_adv *pdu;
 	uint16_t interval;
 	uint32_t slot_us;
@@ -1025,6 +1030,10 @@ void ull_sync_setup(struct ll_scan_set *scan, uint8_t phy,
 	}
 
 	sync->sync_expire = CONN_ESTAB_COUNTDOWN;
+	sync->estab_events = 0U;
+	sync->estab_crc_fail = 0U;
+	lll->estab_extra_us = 0U;
+	lll->estab_err_us = 0;
 
 	/* Extract the SCA value from the sca_chm field of the sync_info
 	 * structure.
@@ -1109,6 +1118,26 @@ void ull_sync_setup(struct ll_scan_set *scan, uint8_t phy,
 	/* CPU execution overhead to setup the radio for reception */
 	overhead_us += EVENT_OVERHEAD_END_US + EVENT_OVERHEAD_START_US;
 
+	/* Open the first receive window CONFIG_BT_CTLR_SYNC_ESTAB_WINDOW_US
+	 * before and after the time the SyncInfo offset names, for
+	 * advertisers whose offset is wrong, keeping the window inside one
+	 * periodic interval. The anchor is re-aligned to where the first PDU
+	 * is actually received, so later events use the normal window.
+	 */
+	estab_extra_us = MIN(CONFIG_BT_CTLR_SYNC_ESTAB_WINDOW_US,
+			     lll->window_widening_max_us);
+	if (estab_extra_us) {
+		while ((sync_offset_us - ftr->radio_end_us) <
+		       (estab_extra_us + overhead_us)) {
+			sync_offset_us += interval_us;
+			lll->event_counter++;
+		}
+
+		lll->window_size_event_us += 2U * estab_extra_us;
+		sync_offset_us -= estab_extra_us;
+	}
+	lll->estab_extra_us = estab_extra_us;
+
 	/* If not sufficient CPU processing time, skip to receiving next
 	 * event.
 	 */
@@ -1130,6 +1159,14 @@ void ull_sync_setup(struct ll_scan_set *scan, uint8_t phy,
 
 	sync->ull.ticks_slot = HAL_TICKER_US_TO_TICKS_CEIL(slot_us);
 
+	/* Reserve the establishment window too, until the first PDU is
+	 * received (ull_sync_done gives it back).
+	 */
+	sync->ticks_slot_estab_extra =
+		HAL_TICKER_US_TO_TICKS_CEIL(slot_us + (2U * estab_extra_us)) -
+		sync->ull.ticks_slot;
+	sync->ull.ticks_slot += sync->ticks_slot_estab_extra;
+
 	ticks_slot_offset = HAL_TICKER_US_TO_TICKS(EVENT_OVERHEAD_XTAL_US);
 	if (IS_ENABLED(CONFIG_BT_CTLR_LOW_LAT)) {
 		ticks_slot_overhead = ticks_slot_offset;
@@ -1247,6 +1284,10 @@ void ull_sync_established_report(memq_link_t *link, struct node_rx_pdu *rx)
 		se->status = BT_HCI_ERR_SUCCESS;
 #endif /* CONFIG_BT_CTLR_SYNC_PERIODIC_CTE_TYPE_FILTERING */
 
+		se->estab_err_us = lll->estab_err_us;
+		se->events = sync->estab_events;
+		se->crc_fail = sync->estab_crc_fail;
+
 		/* NOTE: footer param has already been populated during sync
 		 * setup.
 		 */
@@ -1313,6 +1354,7 @@ void ull_sync_done(struct node_rx_event_done *done)
 	{
 		uint32_t ticks_drift_minus;
 		uint32_t ticks_drift_plus;
+		uint32_t ticks_slot_minus;
 		uint16_t elapsed_event;
 		struct lll_sync *lll;
 		uint16_t skip_event;
@@ -1328,6 +1370,19 @@ void ull_sync_done(struct node_rx_event_done *done)
 		/* Sync drift compensation and new skip calculation */
 		ticks_drift_plus = 0U;
 		ticks_drift_minus = 0U;
+		ticks_slot_minus = 0U;
+
+		/* Count what establishing the sync took, for its timing event */
+		if (sync->node_rx_sync_estab) {
+			if (sync->estab_events < UINT8_MAX) {
+				sync->estab_events++;
+			}
+			if (done->extra.trx_cnt && !done->extra.crc_valid &&
+			    (sync->estab_crc_fail < UINT8_MAX)) {
+				sync->estab_crc_fail++;
+			}
+		}
+
 		if (done->extra.trx_cnt) {
 			/* Calculate drift in ticks unit */
 			ull_drift_ticks_get(done, &ticks_drift_plus, &ticks_drift_minus);
@@ -1335,6 +1390,15 @@ void ull_sync_done(struct node_rx_event_done *done)
 			/* Enforce skip */
 			lll->skip_event = sync->skip;
 
+			/* First PDU received: the establishment receive
+			 * window's time reservation is no longer needed.
+			 */
+			if (sync->sync_expire && sync->ticks_slot_estab_extra) {
+				ticks_slot_minus = sync->ticks_slot_estab_extra;
+				sync->ull.ticks_slot -= ticks_slot_minus;
+				sync->ticks_slot_estab_extra = 0U;
+			}
+
 			/* Reset failed to establish sync countdown */
 			sync->sync_expire = 0U;
 		}
@@ -1395,7 +1459,8 @@ void ull_sync_done(struct node_rx_event_done *done)
 		}
 
 		/* Update Sync ticker instance */
-		if (ticks_drift_plus || ticks_drift_minus || lazy || force) {
+		if (ticks_drift_plus || ticks_drift_minus || ticks_slot_minus ||
+		    lazy || force) {
 			uint16_t sync_handle = ull_sync_handle_get(sync);
 			uint32_t ticker_status;
 
@@ -1412,7 +1477,8 @@ void ull_sync_done(struct node_rx_event_done *done)
 					      (TICKER_ID_SCAN_SYNC_BASE +
 					       sync_handle),
 					      ticks_drift_plus,
-					      ticks_drift_minus, 0, 0,
+					      ticks_drift_minus, 0,
+					      ticks_slot_minus,
 					      lazy, force,
 					      ticker_update_op_cb, sync);
 			LL_ASSERT_ERR((ticker_status == TICKER_STATUS_SUCCESS) ||
@@ -1769,6 +1835,9 @@ static void sync_expire(void *param)
 	 */
 	se = (void *)rx->pdu;
 	se->status = BT_HCI_ERR_CONN_FAIL_TO_ESTAB;
+	se->estab_err_us = 0;
+	se->events = sync->estab_events;
+	se->crc_fail = sync->estab_crc_fail;
 
 	/* NOTE: footer param has already been populated during sync setup */
 
diff --git a/subsys/bluetooth/controller/ll_sw/ull_sync_iso.c b/subsys/bluetooth/controller/ll_sw/ull_sync_iso.c
