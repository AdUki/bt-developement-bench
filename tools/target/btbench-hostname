#!/bin/sh
# btbench-hostname — give the board a name of its own: the device conf's hostname (/etc/hostname,
# "btbench") with the board's MAC address after it, e.g. btbench-257bfc. Every image carries the
# same /etc/hostname, so two boards on one network would both answer btbench.local, and mDNS
# (systemd-resolved) renames one of them unpredictably; with the MAC after it each has a stable
# name: ssh root@btbench-257bfc.local. btbench-hostname.service runs it at every boot.
#
# The MAC is the Wi-Fi's (wlan0), or the first other interface with a burned-in address: the last
# three bytes, since a Raspberry Pi's all start b8:27:eb or dc:a6:32 (the Pi Foundation's). It is a
# transient hostname, the kernel's: the static one in /etc/hostname stays as the image has it (the
# root filesystem is read-only), and systemd-resolved and networkd follow the change by themselves.
# It runs alongside the network services, not before them (the Wi-Fi interface appears seconds
# into the boot): for them it is a rename, which they follow.
#
# A name given in the console (System → Name, PUT /api/system/hostname) is kept in
# /data/btbench/hostname and is the board's as it is, with no MAC after it: btbench-rpi5 says which
# board it is where btbench-59c787 does not. btbenchd runs this again when it changes.
#
# Settings (/etc/btbench/device.env): HOSTNAME_MAC=0 keeps the plain name.
# Never fails the boot: without an address the name stays as it is, and that is logged.

log() { echo "btbench-hostname: $*"; }

# The kernel's hostname, written directly: `hostnamectl --transient` does nothing while a static
# hostname is set (it says it did), and the static one cannot change on a read-only root.
set_name() {
    [ "$(hostname)" = "$1" ] && return 0
    if echo "$1" > /proc/sys/kernel/hostname; then
        log "hostname $1 ($2)"
    else
        log "could not set the hostname to $1"
    fi
}

# btbenchd checks the name on the way in; a hand-written one is checked here the same way.
own=$(cat /data/btbench/hostname 2>/dev/null | tr -d '[:space:]')
case $own in
    '' | -* | *- | *[!a-z0-9-]*) ;;
    *) [ ${#own} -le 63 ] && { set_name "$own" "given in the console"; exit 0; } ;;
esac

base=$(cat /etc/hostname 2>/dev/null)
[ -n "$base" ] || base=btbench

# A console name taken back goes back to the image's (set again here, the kernel keeps the old).
HOSTNAME_MAC=1
[ -r /etc/btbench/device.env ] && . /etc/btbench/device.env
[ "${HOSTNAME_MAC:-1}" = 0 ] && { set_name "$base" "the image's"; exit 0; }

# A burned-in (universally administered) address: bit 1 of the first byte clear. usb0's, the
# gadget's, is made up at every boot.
burned() {
    a=$(cat "/sys/class/net/$1/address" 2>/dev/null) || return 1
    [ -n "$a" ] && [ "$a" != 00:00:00:00:00:00 ] || return 1
    [ $(( 0x${a%%:*} & 2 )) -eq 0 ] || return 1
    echo "$a"
}

# The Wi-Fi driver (brcmfmac over SDIO) comes up some seconds into the boot: wait for it, and only
# then settle for another interface. Taking the first one there is would make the name depend on
# which driver won the race: on a Pi 5 the Ethernet (on the RP1) is up seconds before the Wi-Fi,
# and the board would answer to one name or the other from boot to boot.
mac=
for i in $(seq 1 20); do
    mac=$(burned wlan0) && break
    sleep 1
done
if [ -z "$mac" ]; then
    for n in /sys/class/net/*; do
        n=${n##*/}
        case $n in lo | wlan0 | usb* | p2p*) continue ;; esac
        mac=$(burned "$n") && break
    done
fi
if [ -z "$mac" ]; then
    log "no interface with a burned-in MAC address: the name stays $(hostname)"
    exit 0
fi

tag=$(echo "$mac" | cut -d: -f4-6 | tr -d : | tr 'A-F' 'a-f')
case $base in *-"$tag") name=$base ;; *) name=$base-$tag ;; esac
set_name "$name" "from $mac"
exit 0
