#!/bin/sh
# btbench-audio — the board's audio stack: PipeWire and WirePlumber.
#
#   btbench-audio status                    JSON: {"stack":"pipewire","services":{..}}
#   btbench-audio restart [--restart-bt]    restart PipeWire and WirePlumber (and bluetoothd)
#   btbench-audio boot                      start the stack (btbench-audio-select.service)
#   btbench-audio get                       "pipewire" (what older callers asked for the mode)
#
# PipeWire is the bench's audio stack, always: the streams, the codec picker and the board's player
# are all built on it. The stack is btbench-audio-pipewire.target, which wants PipeWire and
# WirePlumber; their services are PartOf= it, so restarting the target restarts both.
#
# A restart is the cure for a WirePlumber that has stopped answering (it has been seen spinning
# after Bluetooth links vanished all at once). The links that carry audio are dropped first, so the
# devices reconnect to the new PipeWire's endpoints instead of keeping a transport whose owner has
# gone; --restart-bt also restarts bluetoothd, which clears what the old stack left on the adapter.
#
# Called by btbenchd and `bench`: no terminal, JSON on stdout, a one-line reason on stderr and a
# non-zero exit on failure.

set -u

TARGET=btbench-audio-pipewire.target

# Profiles whose connections belong to the audio stack: A2DP source/sink/AVDTP, HSP HS/AG,
# HFP HF/AG, ASCS, BASS, PACS, CAS. Their links are dropped before the stack restarts.
AUDIO_UUIDS='0000(110a|110b|110d|1108|1112|111e|111f|184e|184f|1850|1853)-'

die() {
	echo "btbench-audio: $*" >&2
	exit 1
}

service_state() {
	s=$(systemctl is-active "$1.service" 2>/dev/null)
	echo "${s:-unknown}"
}

# Drop the links that carry audio, so the device reconnects to the new stack's endpoints.
disconnect_audio() {
	systemctl -q is-active bluetooth.service 2>/dev/null || return 0
	command -v bluetoothctl > /dev/null || return 0

	timeout 10 bluetoothctl devices Connected 2>/dev/null |
	while read -r kind addr _; do
		[ "$kind" = Device ] || continue
		timeout 10 bluetoothctl info "$addr" 2>/dev/null | grep -qiE "$AUDIO_UUIDS" || continue
		timeout 15 bluetoothctl disconnect "$addr" > /dev/null 2>&1 ||
			echo "btbench-audio: could not disconnect $addr" >&2
	done
}

cmd_status() {
	printf '{"stack":"pipewire","services":{"pipewire":"%s","wireplumber":"%s"}}\n' \
		"$(service_state pipewire)" "$(service_state wireplumber)"
}

cmd_restart() {
	restart_bt=0
	for a in "$@"; do
		case "$a" in
		--restart-bt) restart_bt=1 ;;
		*) die "unknown option '$a'" ;;
		esac
	done
	disconnect_audio
	systemctl restart "$TARGET" ||
		die "restarting $TARGET failed (journalctl -b -u $TARGET)"
	if [ "$restart_bt" = 1 ]; then
		systemctl restart bluetooth.service || die "restarting bluetooth.service failed"
	fi
}

case "${1:-}" in
status) cmd_status ;;
restart)
	shift
	cmd_restart "$@"
	;;
boot)
	# --no-block: this runs inside a unit during boot; the target's services start on their own.
	systemctl start --no-block "$TARGET" || die "starting $TARGET failed"
	;;
get) echo pipewire ;;
*)
	echo "usage: btbench-audio status | restart [--restart-bt] | boot" >&2
	exit 2
	;;
esac
