# yocto/build-<board>/conf/local.conf — created once from yocto/conf/local.conf.sample and then
# yours to edit: the Makefile never rewrites it. Board settings are in yocto/conf/boards/, the
# cache dirs in site.conf (make configure), the device settings in btbench-device.conf.

DISTRO ?= "btbench"
PACKAGE_CLASSES ?= "package_ipk"

BB_NUMBER_THREADS ?= "${@oe.utils.cpu_count()}"
PARALLEL_MAKE ?= "-j ${@oe.utils.cpu_count()}"

# Fallbacks only: `make configure` writes the real ones into site.conf, which is parsed first.
DL_DIR ?= "${TOPDIR}/../downloads"
SSTATE_DIR ?= "${TOPDIR}/../sstate-cache"

USER_CLASSES ?= "buildstats"
PATCHRESOLVE = "noop"
CONF_VERSION = "2"

BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
    HALT,/tmp,10M,1K"
