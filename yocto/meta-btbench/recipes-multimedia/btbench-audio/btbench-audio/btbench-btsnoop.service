# The always-on HCI capture: a ring of btmon files in RAM, /tmp/btsnoop (see /usr/bin/btbench-btsnoop
# for the settings; override them in /data/btbench/btsnoop.env). btbenchd lists, downloads and
# analyses the files, and stops and starts this unit for PUT /api/capture.
[Unit]
Description=btmon capture ring in /tmp/btsnoop
RequiresMountsFor=/data /tmp
After=local-fs.target

[Service]
EnvironmentFile=-/data/btbench/btsnoop.env
ExecStart=/usr/bin/btbench-btsnoop
# btmon writes every packet, A2DP's included: below the audio it is recording, so a busy core
# delays the capture (the kernel's monitor socket buffers it), not the stream.
Nice=10
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
