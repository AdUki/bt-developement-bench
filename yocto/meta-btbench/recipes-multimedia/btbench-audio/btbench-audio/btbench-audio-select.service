# Starts the audio stack (btbench-audio-pipewire.target) at boot. PipeWire's own units are not
# enabled: this is the only thing that starts them, so the target owns them.
[Unit]
Description=Start the audio stack (btbench-audio)
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/bin/btbench-audio boot

[Install]
WantedBy=multi-user.target
