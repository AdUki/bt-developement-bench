# Audio mode "pipewire": PipeWire system-wide with WirePlumber (btbench-audio set pipewire).
#
# The three btbench-audio-*.target conflict with each other, and each stack's units are PartOf=
# their target (drop-ins next to the units), so starting one target stops the other stack. The
# After= between the targets only orders that stop before this start.
[Unit]
Description=Audio mode: PipeWire with WirePlumber
Conflicts=btbench-audio-bluealsa.target btbench-audio-none.target
After=btbench-audio-bluealsa.target btbench-audio-none.target
Wants=pipewire.socket pipewire-manager.socket pipewire.service wireplumber.service
