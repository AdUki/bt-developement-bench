# The board's audio stack: PipeWire system-wide with WirePlumber, started at boot by
# btbench-audio-select.service. PipeWire's units are PartOf= this target (drop-ins next to the
# units), so `btbench-audio restart` (systemctl restart of this target) restarts them all.
[Unit]
Description=Audio stack: PipeWire with WirePlumber
Wants=pipewire.socket pipewire-manager.socket pipewire.service wireplumber.service
