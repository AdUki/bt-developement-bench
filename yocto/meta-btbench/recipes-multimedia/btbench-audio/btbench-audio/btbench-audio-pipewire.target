# Audio mode "pipewire": PipeWire system-wide with WirePlumber (btbench-audio set pipewire).
#
# The two btbench-audio-*.target conflict with each other, and PipeWire's units are PartOf= this
# target (drop-ins next to the units), so starting the "none" target stops PipeWire. The After=
# between the targets only orders that stop before the other start.
[Unit]
Description=Audio mode: PipeWire with WirePlumber
Conflicts=btbench-audio-none.target
After=btbench-audio-none.target
Wants=pipewire.socket pipewire-manager.socket pipewire.service wireplumber.service
