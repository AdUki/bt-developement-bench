# btbench boot script: meta-raspberrypi's boot, plus a one-shot trial of /boot/bench/test/.
#
# `btbench-kernel try` sets bench_try=1 in uboot.env (fw_setenv) and reboots. This script clears
# it and saves the environment *before* it loads the test kernel, so whatever that kernel does
# (panic, hang, no network), the next reset boots the good kernel: a panic reboots by itself
# (panic=10), a hang is ended by the SoC watchdog armed below, anything else by a power cycle.
#
# The firmware has loaded config.txt's device tree at ${fdt_addr} and put the kernel command line
# (cmdline.txt) into its /chosen/bootargs. Both slots boot with that command line; the test slot
# adds panic=10, btbench.slot=test and whatever is in the env variable bench_bootargs
# (fw_setenv bench_bootargs "dyndbg=..."). The test slot's own device tree, if it has one,
# replaces the firmware's, and U-Boot writes bootargs into its /chosen when it boots.

# Where the kernel goes. An arm64 Image (booti) is loaded at 256 MiB, not at kernel_addr_r
# (0x80000): booti would move it up to 0x200000, and U-Boot's layout (rpi.env) keeps only up to
# 0x02400000 free for it, "roughly 36M". bluetooth-next's Image for the Pi 5 takes 38 MB once its
# BSS is counted and runs into scriptaddr, fdt_addr_r and whatever the firmware left there; 256 MiB
# is 2 MiB-aligned (booti leaves the Image where it is), above the ramoops region (176 MiB) and the
# test slot's device tree (128 MiB), and RAM on every 64-bit Pi. A 32-bit zImage (bootz) stays at
# kernel_addr_r: the kernel's AUTO_ZRELADDR needs it in the first 128 MiB.
setenv bench_kernel_addr ${kernel_addr_r}
if test "@@KERNEL_BOOTCMD@@" = "booti"; then
	setenv bench_kernel_addr 0x10000000
fi

if test "${bench_try}" = "1"; then
	setenv bench_try 0
	# Where the firmware put its device tree, for the record (fw_printenv bench_fw_fdt).
	setenv bench_fw_fdt ${fdt_addr}
	# The next boot saves the kernel log of this one (below).
	setenv bench_tried 1
	# The SoC watchdog, looked up now so that which one (or none) is saved with the environment:
	# fw_printenv bench_wdt says afterwards whether a hung test kernel could have been reset.
	# watchdog@7d200000 is the BCM2712's (Raspberry Pi 5), where U-Boot may have no driver.
	setenv bench_wdt none
	if wdt dev watchdog@7e100000; then
		setenv bench_wdt watchdog@7e100000
	elif wdt dev watchdog@7d200000; then
		setenv bench_wdt watchdog@7d200000
	fi
	# Never boot the test kernel without having made sure the next boot will not.
	if saveenv; then
		echo "btbench: trial boot of bench/test/ (this boot only)"
		fdt addr ${fdt_addr} && fdt get value bootargs /chosen bootargs
		setenv bootargs "${bootargs} panic=10 btbench.slot=test ${bench_bootargs}"
		# The firmware's board serial (the source of the bench's Bluetooth address); it is put into
		# the test slot's device tree, which does not have it otherwise.
		setenv bench_serial
		fdt get value bench_serial / serial-number

		if fatload @@BOOT_MEDIA@@ 0:1 ${bench_kernel_addr} bench/test/@@KERNEL_IMAGETYPE@@; then
			setenv bench_fdt ${fdt_addr}
			# The test slot's device tree goes at 128 MiB, not at fdt_addr_r (0x2600000): booti
			# moves an arm64 Image up to the next 2 MiB boundary and the kernel clears its BSS past
			# the end of the file, so a kernel of ~36 MB already reaches fdt_addr_r and wipes the
			# tree while it starts (fdt_high is all ones: U-Boot boots the tree where it is). 128 MiB
			# is clear of any kernel, below the ramoops region at 176 MiB, and RAM on every Pi.
			setenv bench_fdt_addr 0x08000000
			if test -e @@BOOT_MEDIA@@ 0:1 bench/test/board.dtb; then
				if fatload @@BOOT_MEDIA@@ 0:1 ${bench_fdt_addr} bench/test/board.dtb; then
					setenv bench_fdt ${bench_fdt_addr}
					fdt addr ${bench_fdt_addr}
					fdt resize 4096
					if test -n "${bench_serial}"; then
						fdt set / serial-number "${bench_serial}"
					fi
				fi
			fi

			# The SoC watchdog (16 s at most), for a kernel that hangs before systemd takes the
			# watchdog over; the kernel's bcm2835_wdt keeps it fed from its probe on. A U-Boot
			# without the wdt command or driver just skips this.
			if test "${bench_wdt}" != "none"; then
				wdt dev ${bench_wdt} && wdt start 15000
			fi

			@@KERNEL_BOOTCMD@@ ${bench_kernel_addr} - ${bench_fdt}

			wdt stop
			echo "btbench: the test kernel did not start; booting the good one"
		else
			echo "btbench: no bench/test/@@KERNEL_IMAGETYPE@@; booting the good kernel"
		fi
	else
		echo "btbench: could not save the environment; not booting the test kernel"
	fi
fi

# The boot after a trial keeps that trial's kernel log: the ramoops region of the board's device
# tree (0x0b000000, 1 MiB, the same on every Pi's dtsi) survives a warm reset (a panic's reboot,
# the watchdog) and is copied to bench/test/ramoops.bin before the good kernel boots, which has no
# ramoops region of its own (the downstream one) or reuses it. After a power cycle it holds noise.
if test "${bench_tried}" = "1"; then
	setenv bench_tried 0
	fatwrite @@BOOT_MEDIA@@ 0:1 0x0b000000 bench/test/ramoops.bin 0x100000
	saveenv
fi

fdt addr ${fdt_addr} && fdt get value bootargs /chosen bootargs
fatload @@BOOT_MEDIA@@ 0:1 ${bench_kernel_addr} @@KERNEL_IMAGETYPE@@
if test ! -e @@BOOT_MEDIA@@ 0:1 uboot.env; then saveenv; fi;
@@KERNEL_BOOTCMD@@ ${bench_kernel_addr} - ${fdt_addr}
