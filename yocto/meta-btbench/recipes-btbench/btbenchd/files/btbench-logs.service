[Unit]
Description=btbench-logd: the journal as one native-format file per program in /tmp/logs (for clog)
# Reads the journal from the start of journald, and follows it.
After=systemd-journald.service local-fs.target
Wants=systemd-journald.service

[Service]
Type=simple
# /tmp is a tmpfs: the files live in RAM, 2 MiB each before they rotate once (.1). btsnoop links to
# the capture ring, so everything a bug report needs is in one directory.
ExecStart=/usr/bin/btbench-logd --dir /tmp/logs --max-kib 2048 --link btsnoop=/data/btsnoop
# A burst of BT_DBG (btbench-btdebug) must not take the core from what is being debugged.
Nice=10
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
