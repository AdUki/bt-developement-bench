# Header-only, all of them (btbenchd, app/): nothing here is built or linked, the include path just
# points into these trees. Pinned to the same commits as rpi-sound-tester.
[submodule "app/third_party/httplib"]
	path = app/third_party/httplib
	url = https://github.com/yhirose/cpp-httplib
	shallow = true
[submodule "app/third_party/json"]
	path = app/third_party/json
	url = https://github.com/nlohmann/json
	shallow = true
[submodule "app/third_party/spdlog"]
	path = app/third_party/spdlog
	url = https://github.com/gabime/spdlog
	shallow = true
[submodule "app/third_party/cli11"]
	path = app/third_party/cli11
	url = https://github.com/CLIUtils/CLI11
	shallow = true
[submodule "src/bluez"]
	path = src/bluez
	url = https://github.com/AdUki/bluez.git
	branch = bench
[submodule "src/pipewire"]
	path = src/pipewire
	url = https://github.com/AdUki/pipewire.git
	branch = bench
[submodule "src/wireplumber"]
	path = src/wireplumber
	url = https://github.com/AdUki/wireplumber.git
	branch = bench
[submodule "src/linux"]
	path = src/linux
	url = https://github.com/AdUki/linux.git
	branch = bench
	shallow = true
